[Unit]
Description=Hermes Dashboard — sessie & token gebruik statistieken
After=network.target hermes-gateway.service

[Service]
Type=simple
WorkingDirectory=%h/hermes-statistieken
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8088 --log-level warning
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
