[Unit]
Description=Hermes Dashboard — sessie & gebruik statistieken
After=network.target hermes-gateway.service

[Service]
Type=simple
WorkingDirectory=%h/.hermes/dashboard
ExecStart=%h/.hermes/hermes-agent/venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8088 --log-level warning
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
